# ============================================================
# BOI RSU BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your actual values


# Deepgram API (for text-to-speech)
DEEPGRAM_API_KEY=

# Paystack API (for payments)
PAYSTACK_SECRET_KEY=

# NVIDIA API (for AI course generation)
NVIDIA_API_KEY=

# Apify API (for web scraping)
APIFY_TOKEN=

# Tavily API (for web search)
TAVILY_API_KEY=

# YouTube API (for video recommendations)
YOUTUBE_API_KEY=

# Admin contact
BOIRSU_ADMIN_PHONE=+234800BOI TECH
GOOGLE_FORM_URL=https://forms.google.com/your-form

# Bot service
BOI_YOUTUBE_RECOMMENDATIONS=[]

# PostgreSQL database (replaces Supabase). Example:
#   postgresql://postgres:YOUR_PASSWORD@localhost:5432/school_rsu
DATABASE_URL=
# DB_POOL_MIN / DB_POOL_MAX — pooled connections PER server process.
#   Total across all processes = DB_POOL_MAX x process count.
#   Keep the total under ~40-50, or put PgBouncer in front of PostgreSQL.
# DB_STATEMENT_TIMEOUT_MS — kills queries stuck longer than this, so one
#   heavy page can never pile up connections and stall the whole app.
# DB_POOL_MIN=2
# DB_POOL_MAX=8
# DB_STATEMENT_TIMEOUT_MS=15000
